server {
    listen 80;
    server_name _;

    # DNS interne de Docker : les noms "web" et "webmail" sont résolus à chaque
    # requête, donc le proxy suit les conteneurs même s'ils sont recréés (nouvelle IP).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $web_upstream     http://web:9000;
    set $webmail_upstream http://webmail:80;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WICM Game + API -> http://IP/
    location / {
        proxy_pass $web_upstream;
    }

    # Webmail Roundcube -> http://IP/webmail/
    location = /webmail {
        return 301 /webmail/;
    }

    location /webmail/ {
        rewrite ^/webmail/(.*)$ /$1 break;
        proxy_pass $webmail_upstream;
        client_max_body_size 25m;
    }
}
